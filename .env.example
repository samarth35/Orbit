ORBIT_PUBLIC_BASE_URL=http://127.0.0.1:4174
ORBIT_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Production persistence. Leave blank for local SQLite fallback.
DATABASE_URL=

# Google OAuth. For production, use your deployed HTTPS URL:
# ORBIT_GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
ORBIT_GOOGLE_CLIENT_ID=
ORBIT_GOOGLE_CLIENT_SECRET=
ORBIT_GOOGLE_REDIRECT_URI=http://127.0.0.1:4174/api/auth/google/callback

# Optional overrides. Leave blank for Google's default endpoints.
ORBIT_GOOGLE_AUTH_URL=
ORBIT_GOOGLE_TOKEN_URL=
